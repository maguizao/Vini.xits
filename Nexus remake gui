    tabBtn.Font = Enum.Font.GothamSemibold
    tabBtn.TextColor3 = NexusUI.CurrentTheme.TextDim
    tabBtn.TextSize = 11
    tabBtn.AutoButtonColor = false
    tabBtn.Parent = NexusUI.TabScrollFrame
    AddCorner(tabBtn, 6)

    -- Frame da aba (dentro do slide container)
    local tabFrame = Instance.new("ScrollingFrame")
    tabFrame.Size = UDim2.new(1, 0, 1, 0)
    tabFrame.BackgroundTransparency = 1
    tabFrame.ScrollBarThickness = 4
    tabFrame.ScrollBarImageColor3 = NexusUI.CurrentTheme.Accent
    tabFrame.Visible = false
    tabFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    tabFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    tabFrame.Parent = NexusUI.SlideContainer

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = tabFrame

    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 5)
    padding.PaddingLeft = UDim.new(0, 8)
    padding.PaddingBottom = UDim.new(0, 5)
    padding.Parent = tabFrame

    local tabEntry = { Btn = tabBtn, Frame = tabFrame, IsFixed = isFixed or false }
    table.insert(NexusUI.Tabs, tabEntry)

    -- Clique na aba: slide animado
    tabBtn.MouseButton1Click:Connect(function()
        PlayClickSound()
        local index = 0
        for i, t in ipairs(NexusUI.Tabs) do
            if t == tabEntry then
                index = i
                break
            end
        end
        NexusUI.SwitchTab(index)
    end)

    ReorderTabs()
    return tabFrame
end

-- Função para alternar abas com slide animado
function NexusUI.SwitchTab(index)
    if NexusUI.TabAnimating then return end
    if not NexusUI.Tabs[index] then return end

    NexusUI.TabAnimating = true

    -- Atualiza cores dos botões
    for i, t in ipairs(NexusUI.Tabs) do
        if i == index then
            TweenService:Create(t.Btn, TweenInfo.new(0.2), {
                TextColor3 = NexusUI.CurrentTheme.Text,
                BackgroundColor3 = NexusUI.CurrentTheme.AccentDark,
                BackgroundTransparency = 0
            }):Play()
        else
            TweenService:Create(t.Btn, TweenInfo.new(0.2), {
                TextColor3 = NexusUI.CurrentTheme.TextDim,
                BackgroundColor3 = NexusUI.CurrentTheme.Background,
                BackgroundTransparency = 0.2
            }):Play()
        end
    end

    -- Slide horizontal
    local container = NexusUI.SlideContainer
    local targetPos = UDim2.new(-(index - 1), 0, 0, 0)
    
    -- Primeiro, mostra a aba que vai aparecer
    for i, t in ipairs(NexusUI.Tabs) do
        if i == index then
            t.Frame.Visible = true
        end
    end

    TweenService:Create(container, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
        Position = targetPos
    }):Play()

    task.wait(0.45)
    
    -- Esconde as outras abas
    for i, t in ipairs(NexusUI.Tabs) do
        if i ~= index then
            t.Frame.Visible = false
        end
    end

    NexusUI.CurrentTabIndex = index
    NexusUI.TabAnimating = false
end

